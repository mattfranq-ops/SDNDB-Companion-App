{
  "name": "sdndbz-companion",
  "version": "1.13.2",
  "description": "SDNDBZ Companion - character sheets, combat tracker, NPCs, tables, shared live across the table.",
  "main": "main.js",
  "scripts": {
    "build:renderer": "esbuild renderer/entry.jsx --bundle --outfile=dist/bundle.js --loader:.js=jsx --define:process.env.NODE_ENV=\\\"production\\\"",
    "postbuild": "node -e \"const fs=require('fs');let h=fs.readFileSync('renderer/index.html','utf8').replace('bundle.js','bundle.js?v='+Date.now());fs.writeFileSync('dist/index.html',h)\"",
    "build": "npm run build:renderer && npm run postbuild",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5"
  },
  "build": {
    "appId": "com.sdndbz.companion",
    "productName": "SDNDBZ Companion",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}