{
  "name": "sdndbz-companion",
  "version": "1.13.2",
  "description": "SDNDBZ Companion - character sheets, combat tracker, NPCs, tables, shared live across the table.",
  "main": "main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "electron": "electron .",
    "serve": "node server.js",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/orbitron": "^5.1.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.sdndbz.companion",
    "productName": "SDNDBZ Companion",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
